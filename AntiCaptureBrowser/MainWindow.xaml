<Window x:Class="AntiCaptureBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="AntiCaptureBrowser" Height="760" Width="1180"
        MinHeight="460" MinWidth="720"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource ChromeBgBrush}"
        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
        KeyDown="Window_KeyDown"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 导航/图标按钮 -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundDimBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 自定义标题栏窗口按钮（最小化/最大化） -->
        <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 关闭按钮：悬停红色 -->
        <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CloseHoverBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ 自定义标题栏（含标签页栏） ============ -->
        <Border Grid.Row="0" Background="{DynamicResource ChromeBgBrush}">
            <DockPanel Margin="10,0,0,0" LastChildFill="True">
                <!-- 窗口控制按钮 -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BtnMinimize" Style="{StaticResource CaptionButton}"
                            Content="&#xE921;" ToolTip="最小化" Click="BtnMinimize_Click" />
                    <Button x:Name="BtnMaximize" Style="{StaticResource CaptionButton}"
                            Content="&#xE922;" ToolTip="最大化" Click="BtnMaximize_Click" />
                    <Button x:Name="BtnClose" Style="{StaticResource CaptionCloseButton}"
                            Content="&#xE8BB;" ToolTip="关闭" Click="BtnClose_Click" />
                </StackPanel>

                <!-- 应用标识 -->
                <Border Width="30" Height="30" CornerRadius="6" Margin="0,0,8,5"
                        VerticalAlignment="Bottom" Background="{DynamicResource AccentBrush}">
                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Foreground="{DynamicResource BadgeFgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- 标签页 + 新建标签页按钮（跟随末尾，与标签垂直居中对齐） -->
                <ScrollViewer x:Name="TabScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                              PreviewMouseMove="TabStrip_PreviewMouseMove"
                              PreviewMouseLeftButtonUp="TabStrip_PreviewMouseUp"
                              LostMouseCapture="TabScroll_LostMouseCapture">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <ItemsControl x:Name="TabsList" VerticalAlignment="Bottom">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Height="34" Width="{Binding TabWidth}" Margin="0,0,2,0" Click="TabButton_Click"
                                        PreviewMouseLeftButtonDown="TabButton_MouseDown" MouseUp="TabButton_MouseUp"
                                        Cursor="Hand" Foreground="{DynamicResource ForegroundBrush}" ToolTip="{Binding Title}"
                                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" CornerRadius="7,7,0,0" Padding="10,0,4,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid x:Name="IconHost" Width="16" Margin="0,0,6,0"
                                                          VerticalAlignment="Center">
                                                        <Image x:Name="FaviconImage" Source="{Binding IconSource}"
                                                               Stretch="Uniform" />
                                                        <TextBlock x:Name="IconGlyph" Text="&#xE774;"
                                                                   FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Visibility="Collapsed" />
                                                    </Grid>
                                                    <TextBlock x:Name="TitleText" Grid.Column="1" Text="{Binding Title}"
                                                               VerticalAlignment="Center" HorizontalAlignment="Left"
                                                               TextTrimming="CharacterEllipsis" FontSize="12" />
                                                    <Button x:Name="CloseBtn" Grid.Column="2" Width="20" Height="20"
                                                            Margin="6,0,0,0" Content="&#xE711;" FontSize="9"
                                                            Style="{StaticResource IconButton}" Visibility="Collapsed"
                                                            Click="TabClose_Click" ToolTip="关闭标签页 (Ctrl+W)" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="bd" Property="Background"
                                                            Value="{DynamicResource TabActiveBrush}" />
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsSelected}" Value="False" />
                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover2Brush}" />
                                                </MultiDataTrigger>
                                                <!-- 关闭按钮：Full 常显；Compact/Icon 仅在激活或悬停的标签上显示 -->
                                                <DataTrigger Binding="{Binding TabWidthMode}" Value="Full">
                                                    <Setter TargetName="CloseBtn" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <Trigger SourceName="bd" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CloseBtn" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                                <!-- 无 favicon 时显示地球兜底标识 -->
                                                <DataTrigger Binding="{Binding IconSource}" Value="{x:Null}">
                                                    <Setter TargetName="FaviconImage" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="IconGlyph" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <!-- 图标模式：标题隐藏；悬停时图标临时替换为关闭按钮 -->
                                                <DataTrigger Binding="{Binding TabWidthMode}" Value="Icon">
                                                    <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding TabWidthMode}" Value="Icon" />
                                                        <Condition Binding="{Binding IsMouseOver, ElementName=bd}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
                                                </MultiDataTrigger>
                                                <Trigger SourceName="CloseBtn" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CloseBtn" Property="Foreground" Value="White" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Button.ContextMenu>
                                        <ContextMenu ContextMenuOpening="TabContextMenuOpening">
                                            <MenuItem Header="刷新标签页" Click="MenuReload_Click" />
                                            <MenuItem Header="复制网址" Click="MenuCopyUrl_Click" />
                                            <MenuItem Header="静音标签页" Tag="mute" Click="MenuMute_Click" />
                                            <MenuItem Header="克隆标签页" Click="MenuDuplicate_Click" />
                                            <MenuItem Header="固定标签页" Tag="pin" Click="MenuPin_Click" />
                                            <Separator />
                                            <MenuItem Header="关闭标签页" InputGestureText="Ctrl+W" Click="TabClose_Click" />
                                            <MenuItem Header="关闭其他标签页" Tag="others" Click="MenuCloseOthers_Click" />
                                            <MenuItem Header="关闭右侧标签页" Tag="right" Click="MenuCloseRight_Click" />
                                            <MenuItem Header="关闭重复标签页" Click="MenuCloseDuplicates_Click" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="BtnNewTab"
                                Width="34" Height="34" Margin="2,0,4,0"
                                VerticalAlignment="Bottom"
                                Foreground="{DynamicResource ForegroundBrush}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="新建标签页 (Ctrl+T)" Click="BtnNewTab_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <!-- 高亮块 30px 垂直对称居中；字形带 MDL2 基线补偿 -->
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="5" Margin="0,2,0,2">
                                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Margin="0,-3,0,0" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background"
                                                    Value="{DynamicResource HoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ============ 工具栏 ============ -->
        <Border Grid.Row="1" Background="{DynamicResource ToolbarBgBrush}" Padding="6,5">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button x:Name="BtnBack" Style="{StaticResource IconButton}" Content="&#xE72B;"
                            ToolTip="后退 (Alt+←)" Click="BtnBack_Click" />
                    <Button x:Name="BtnForward" Style="{StaticResource IconButton}" Content="&#xE72A;"
                            ToolTip="前进 (Alt+→)" Click="BtnForward_Click" />
                    <Button x:Name="BtnReload" Style="{StaticResource IconButton}" Content="&#xE72C;"
                            ToolTip="刷新 (F5)" Click="BtnReload_Click" />
                    <Button x:Name="BtnHome" Style="{StaticResource IconButton}" Content="&#xE80F;"
                            ToolTip="主页" Click="BtnHome_Click" />
                </StackPanel>
                <Button DockPanel.Dock="Right" x:Name="BtnHistory" Style="{StaticResource IconButton}"
                        Content="&#xE823;" ToolTip="浏览历史" Click="BtnHistory_Click" />
                <Button DockPanel.Dock="Right" x:Name="BtnSettings" Style="{StaticResource IconButton}"
                        Content="&#xE713;" ToolTip="设置" Click="BtnSettings_Click" />
                <Border Background="{DynamicResource FieldBgBrush}" CornerRadius="15"
                        Margin="8,0" Padding="12,5" VerticalAlignment="Center">
                    <TextBox x:Name="AddressBox" Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource ForegroundBrush}"
                             CaretBrush="{DynamicResource ForegroundBrush}"
                             FontSize="13" MinWidth="200"
                             PreviewMouseLeftButtonDown="AddressBox_PreviewMouseDown"
                             KeyDown="AddressBox_KeyDown"
                             GotKeyboardFocus="AddressBox_GotKeyboardFocus" />
                </Border>
            </DockPanel>
        </Border>

        <!-- ============ 标签页内容 ============ -->
        <Grid Grid.Row="2" Background="{DynamicResource ChromeBgBrush}">
            <ContentControl x:Name="TabContent" Focusable="False" />
        </Grid>

    </Grid>
</Window>
