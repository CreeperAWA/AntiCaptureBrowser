<UserControl x:Class="AntiCaptureBrowser.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AntiCaptureBrowser.Controls"
             Background="{DynamicResource ToolbarBgBrush}">
    <UserControl.Resources>
        <!-- ===== 侧边栏导航项 ===== -->
        <Style x:Key="NavRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="12,9">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="glyph" Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets"
                                           FontSize="14" VerticalAlignment="Center" Width="20"
                                           Foreground="{DynamicResource ForegroundDimBrush}" />
                                <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"
                                                  RecognizesAccessKey="False" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover2Brush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentTintBrush}" />
                                <Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主按钮 -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource BadgeFgBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SmoothScrollViewer 模板：元素上显式引用（不依赖隐式样式查找） -->
        <ControlTemplate x:Key="SmoothViewerTemplate" TargetType="controls:SmoothScrollViewer">
            <Grid Background="{TemplateBinding Background}">
                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                        CanContentScroll="{TemplateBinding CanContentScroll}"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        Margin="{TemplateBinding Padding}" />
                <ScrollBar x:Name="PART_VerticalScrollBar"
                           Orientation="Vertical"
                           HorizontalAlignment="Right"
                           Margin="0,2"
                           MinWidth="0"
                           MinHeight="0"
                           Width="5"
                           Opacity="0"
                           Maximum="{TemplateBinding ScrollableHeight}"
                           ViewportSize="{TemplateBinding ViewportHeight}"
                           Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                           Template="{StaticResource SlimScrollBarTemplate}" />
            </Grid>
        </ControlTemplate>

        <!-- ===== 页面标题 ===== -->
        <Style x:Key="PageIcon" TargetType="Border">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="{DynamicResource PageIconBgBrush}" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="PageGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        </Style>
        <Style x:Key="PageDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundDimBrush}" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>

        <!-- ===== 卡片与控件 ===== -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,0,26" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundDimBrush}" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundDimBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource FieldBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ComboItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}"
                                CornerRadius="6" Margin="4,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectedComboBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="{DynamicResource FieldBgBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                                            <Path Data="M 0 0 L 4.5 5 L 9 0" Stroke="{DynamicResource ForegroundDimBrush}"
                                                  StrokeThickness="1.6" HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" Margin="0,0,12,0" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="12,7,34,7" IsHitTestVisible="False"
                                              VerticalAlignment="Center" RecognizesAccessKey="False" />
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" StaysOpen="False" Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource Hover2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Margin="0,6,0,0" MaxHeight="280" MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ComboItemStyle}" />
        </Style>

        <Style x:Key="DarkCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="box" Width="19" Height="19" CornerRadius="5"
                                    Background="{DynamicResource FieldBgBrush}"
                                    BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" VerticalAlignment="Center">
                                <Path x:Name="check" Data="M 3.5 9 L 7.5 13 L 14.5 4.5" Stroke="{DynamicResource BadgeFgBrush}"
                                      StrokeThickness="2" Visibility="Collapsed"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"
                                              RecognizesAccessKey="False" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModeRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{DynamicResource FieldBgBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" CornerRadius="10"
                                Padding="14,12">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentTintBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== 左侧分类导航 ==================== -->
        <Border Grid.Column="0" Background="{DynamicResource ChromeBgBrush}">
            <DockPanel Margin="14,20,14,14">
                <!-- 底部：关于 -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,10" />
                    <RadioButton x:Name="NavUserAgent" Style="{StaticResource NavRadio}" GroupName="SettingsNav"
                                 Tag="&#xE779;" Content="User-Agent" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavDefaultBrowser" Style="{StaticResource NavRadio}" GroupName="SettingsNav"
                                 Tag="&#xE8A1;" Content="默认浏览器" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavAbout" Style="{StaticResource NavRadio}" GroupName="SettingsNav"
                                 Tag="&#xE946;" Content="关于" Checked="Nav_Checked" />
                    <TextBlock Text="AntiCaptureBrowser v1.0" FontSize="11" Margin="12,6,0,0"
                               Foreground="{DynamicResource ForegroundDimBrush}" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="设置" FontSize="24" FontWeight="Bold" Margin="10,0,0,22"
                               Foreground="{DynamicResource ForegroundBrush}" />
                    <RadioButton x:Name="NavGeneral" Style="{StaticResource NavRadio}" GroupName="SettingsNav"
                                 Tag="&#xE80F;" Content="常规" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavSearch" Style="{StaticResource NavRadio}" GroupName="SettingsNav"
                                 Tag="&#xE721;" Content="搜索引擎" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavPrivacy" Style="{StaticResource NavRadio}" GroupName="SettingsNav"
                                 Tag="&#xE72E;" Content="隐私与捕获保护" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavHotkey" Style="{StaticResource NavRadio}" GroupName="SettingsNav"
                                 Tag="&#xE765;" Content="快捷键" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavMedia" Style="{StaticResource NavRadio}" GroupName="SettingsNav"
                                 Tag="&#xE769;" Content="隐藏与最小化" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavTray" Style="{StaticResource NavRadio}" GroupName="SettingsNav"
                                 Tag="&#xE7F4;" Content="窗口与托盘" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavParking" Style="{StaticResource NavRadio}" GroupName="SettingsNav"
                                 Tag="&#xE9D2;" Content="标签页停放" Checked="Nav_Checked" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ==================== 右侧内容区 ==================== -->
        <DockPanel Grid.Column="1">
            <!-- 搜索设置 -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource FieldBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10"
                    Margin="28,20,32,4" Padding="14,9">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                               FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0"
                               Foreground="{DynamicResource ForegroundDimBrush}" />
                    <TextBlock x:Name="SearchPlaceholder" Text="搜索设置" FontSize="13" VerticalAlignment="Center"
                               Foreground="{DynamicResource ForegroundDimBrush}" IsHitTestVisible="False" />
                    <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource ForegroundBrush}" CaretBrush="{DynamicResource ForegroundBrush}"
                             FontSize="13" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" />
                </DockPanel>
            </Border>

            <controls:SmoothScrollViewer x:Name="ContentScroll"
                                         VerticalScrollBarVisibility="Auto"
                                         Template="{StaticResource SmoothViewerTemplate}">
                <StackPanel MaxWidth="800" Margin="34,22,34,36" HorizontalAlignment="Center">

                    <!-- ============ 常规 ============ -->
                    <Grid x:Name="PageGeneral">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource PageIcon}">
                                    <TextBlock Style="{StaticResource PageGlyph}" Text="&#xE80F;" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,2,0,0">
                                    <TextBlock Style="{StaticResource PageTitle}" Text="常规" />
                                    <TextBlock Style="{StaticResource PageDesc}" Text="主页与新标签页" />
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="新标签页打开" />
                                    <ComboBox x:Name="HomePageModeCombo" Style="{StaticResource DarkCombo}"
                                              Width="240" HorizontalAlignment="Left" Margin="0,8,0,10"
                                              SelectionChanged="OnSettingChanged">
                                        <ComboBoxItem Content="自定义网址" Tag="CustomUrl" />
                                        <ComboBoxItem Content="空白页" Tag="Blank" />
                                    </ComboBox>
                                    <TextBox x:Name="HomePageUrlBox" Style="{StaticResource FieldBox}"
                                             TextChanged="OnSettingChanged" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                               Text="提示：地址栏输入网址回车即导航；输入普通文字则用「搜索引擎」分类中选择的引擎搜索。" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ============ 搜索引擎 ============ -->
                    <Grid x:Name="PageSearch">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource PageIcon}">
                                    <TextBlock Style="{StaticResource PageGlyph}" Text="&#xE721;" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,2,0,0">
                                    <TextBlock Style="{StaticResource PageTitle}" Text="搜索引擎" />
                                    <TextBlock Style="{StaticResource PageDesc}" Text="地址栏输入文字时使用的搜索服务" />
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="搜索引擎" />
                                    <ComboBox x:Name="SearchEngineCombo" Style="{StaticResource DarkCombo}"
                                              Width="240" HorizontalAlignment="Left" Margin="0,8,0,10"
                                              SelectionChanged="OnSettingChanged">
                                        <ComboBoxItem Content="Google" Tag="google" />
                                        <ComboBoxItem Content="Bing" Tag="bing" />
                                        <ComboBoxItem Content="DuckDuckGo" Tag="duckduckgo" />
                                        <ComboBoxItem Content="百度" Tag="baidu" />
                                        <ComboBoxItem Content="自定义…" Tag="custom" />
                                    </ComboBox>
                                    <TextBox x:Name="CustomSearchUrlBox" Style="{StaticResource FieldBox}"
                                             TextChanged="OnSettingChanged" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                               Text="自定义 URL 模板需包含 {query} 或 %s 占位符，例如：https://example.com/search?q=%s" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ============ 隐私与捕获保护 ============ -->
                    <Grid x:Name="PagePrivacy">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource PageIcon}">
                                    <TextBlock Style="{StaticResource PageGlyph}" Text="&#xE72E;" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,2,0,0">
                                    <TextBlock Style="{StaticResource PageTitle}" Text="隐私与捕获保护" />
                                    <TextBlock Style="{StaticResource PageDesc}"
                                               Text="窗口在截图、录屏、屏幕共享中的显示方式（SetWindowDisplayAffinity）" />
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="捕获保护模式" />
                                    <UniformGrid Columns="3" Margin="0,10,0,0">
                                        <RadioButton x:Name="CaptureCapturable" Style="{StaticResource ModeRadio}"
                                                     GroupName="CaptureMode" Margin="0,0,8,0" Checked="OnSettingChanged">
                                            <StackPanel>
                                                <TextBlock Text="可捕获" FontSize="13.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource ForegroundBrush}" />
                                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                                           Text="正常显示，截图与共享中可见" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="CaptureBlack" Style="{StaticResource ModeRadio}"
                                                     GroupName="CaptureMode" Margin="0,0,8,0" Checked="OnSettingChanged">
                                            <StackPanel>
                                                <TextBlock Text="黑色" FontSize="13.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource ForegroundBrush}" />
                                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                                           Text="截图中窗口显示为黑色" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="CaptureTransparent" Style="{StaticResource ModeRadio}"
                                                     GroupName="CaptureMode" Checked="OnSettingChanged">
                                            <StackPanel>
                                                <TextBlock Text="透明（推荐）" FontSize="13.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                                           Text="防捕获：截图中窗口完全不可见" />
                                            </StackPanel>
                                        </RadioButton>
                                    </UniformGrid>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                                               Text="修改后立即生效。「透明」通过 WDA_EXCLUDEFROMCAPTURE 实现：窗口本体在屏幕上仍正常显示，但任何截图、录屏、屏幕共享、远程软件都看不到它。" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ============ 快捷键 ============ -->
                    <Grid x:Name="PageHotkey">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource PageIcon}">
                                    <TextBlock Style="{StaticResource PageGlyph}" Text="&#xE765;" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,2,0,0">
                                    <TextBlock Style="{StaticResource PageTitle}" Text="快捷键" />
                                    <TextBlock Style="{StaticResource PageDesc}" Text="全局热键在任意程序中都可用" />
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="隐藏 / 恢复窗口（全局热键）" />
                                    <controls:HotkeyBox x:Name="HideHotkeyBox" Width="220" HorizontalAlignment="Left"
                                                        Margin="0,8,0,0" Style="{StaticResource FieldBox}"
                                                        HotkeyChanged="OnSettingChanged" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                               Text="点击输入框后按下组合键即可录入（如 Ctrl+Alt+B）。在任意程序中按此热键可瞬间隐藏/恢复本浏览器。" />
                                    <TextBlock x:Name="HotkeyStatusText" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ============ 隐藏与最小化 ============ -->
                    <Grid x:Name="PageMedia">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource PageIcon}">
                                    <TextBlock Style="{StaticResource PageGlyph}" Text="&#xE769;" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,2,0,0">
                                    <TextBlock Style="{StaticResource PageTitle}" Text="隐藏与最小化" />
                                    <TextBlock Style="{StaticResource PageDesc}" Text="窗口隐藏或最小化时的媒体行为" />
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <CheckBox x:Name="MuteOnHideCheck" Style="{StaticResource DarkCheck}"
                                              Content="静音所有标签页"
                                              Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                                    <CheckBox x:Name="PauseOnHideCheck" Style="{StaticResource DarkCheck}"
                                              Content="暂停页面中的音视频播放" Margin="0,14,0,0"
                                              Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                                               Text="恢复窗口时自动取消静音。" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ============ User-Agent ============ -->
                    <Grid x:Name="PageUserAgent">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource PageIcon}">
                                    <TextBlock Style="{StaticResource PageGlyph}" Text="&#xE779;" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,2,0,0">
                                    <TextBlock Style="{StaticResource PageTitle}" Text="User-Agent" />
                                    <TextBlock Style="{StaticResource PageDesc}" Text="修改浏览器标识，对后续导航生效" />
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="浏览器标识（UA）" />
                                    <ComboBox x:Name="UserAgentCombo" Style="{StaticResource DarkCombo}"
                                              Width="280" HorizontalAlignment="Left" Margin="0,8,0,10"
                                              SelectionChanged="OnSettingChanged">
                                        <ComboBoxItem Content="跟随 WebView2 默认" Tag="default" />
                                        <ComboBoxItem Content="Windows · Chrome" Tag="win-chrome" />
                                        <ComboBoxItem Content="Windows · Edge" Tag="win-edge" />
                                        <ComboBoxItem Content="Android · Chrome（移动版）" Tag="android" />
                                        <ComboBoxItem Content="iPhone · Safari（移动版）" Tag="iphone" />
                                        <ComboBoxItem Content="macOS · Safari" Tag="mac-safari" />
                                        <ComboBoxItem Content="自定义…" Tag="custom" />
                                    </ComboBox>
                                    <TextBox x:Name="CustomUserAgentBox" Style="{StaticResource FieldBox}"
                                             TextChanged="OnSettingChanged" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                               Text="切换为默认时立即恢复；切换为其他 UA 时对标签页的后续导航生效。" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ============ 默认浏览器 ============ -->
                    <Grid x:Name="PageDefaultBrowser">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource PageIcon}">
                                    <TextBlock Style="{StaticResource PageGlyph}" Text="&#xE8A1;" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,2,0,0">
                                    <TextBlock Style="{StaticResource PageTitle}" Text="默认浏览器" />
                                    <TextBlock Style="{StaticResource PageDesc}" Text="注册到系统并在设置中确认选择" />
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="将 AntiCaptureBrowser 设为系统默认浏览器" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,12"
                                               Text="点击后先完成标准应用注册（仅写入当前用户的注册表应用项，不篡改系统默认值），然后打开 Windows「默认应用」设置页，请在列表中选择 AntiCaptureBrowser。" />
                                    <Button Content="设为默认浏览器" Style="{StaticResource PrimaryButton}"
                                            HorizontalAlignment="Left" Click="SetDefaultBrowser_Click" />
                                    <TextBlock x:Name="DefaultBrowserStatus" Style="{StaticResource Hint}" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ============ 标签页停放 ============ -->
                    <Grid x:Name="PageParking">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource PageIcon}">
                                    <TextBlock Style="{StaticResource PageGlyph}" Text="&#xE9D2;" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,2,0,0">
                                    <TextBlock Style="{StaticResource PageTitle}" Text="标签页停放" />
                                    <TextBlock Style="{StaticResource PageDesc}" Text="自动休眠长时间未使用的后台标签页以节省内存（仿 Chrome Memory Saver）" />
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <CheckBox x:Name="ParkingEnabledCheck" Style="{StaticResource DarkCheck}"
                                              Content="自动停放长时间未使用的标签页（激活时自动恢复）"
                                              Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,0" Text="标签页不活动多久后停放" />
                                    <ComboBox x:Name="ParkingTimeoutCombo" Style="{StaticResource DarkCombo}"
                                              Width="200" HorizontalAlignment="Left" Margin="0,8,0,0"
                                              SelectionChanged="OnSettingChanged">
                                        <ComboBoxItem Content="15 分钟" Tag="15" />
                                        <ComboBoxItem Content="30 分钟" Tag="30" />
                                        <ComboBoxItem Content="1 小时" Tag="60" />
                                        <ComboBoxItem Content="2 小时" Tag="120" />
                                    </ComboBox>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                                               Text="固定（Pin）的标签页与当前激活的标签页不会被停放。被停放的标签页激活时会自动恢复。" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ============ 窗口与托盘 ============ -->
                    <Grid x:Name="PageWindowTray">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource PageIcon}">
                                    <TextBlock Style="{StaticResource PageGlyph}" Text="&#xE7F4;" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,2,0,0">
                                    <TextBlock Style="{StaticResource PageTitle}" Text="窗口与托盘" />
                                    <TextBlock Style="{StaticResource PageDesc}" Text="任务栏图标、托盘与窗口标题" />
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <CheckBox x:Name="TaskbarIconCheck" Style="{StaticResource DarkCheck}"
                                              Content="在任务栏显示窗口图标（关闭后改用托盘图标）"
                                              Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                                    <CheckBox x:Name="MinimizeToTrayCheck" Style="{StaticResource DarkCheck}"
                                              Content="最小化时收进托盘" Margin="0,14,0,0"
                                              Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                                    <CheckBox x:Name="CloseToTrayCheck" Style="{StaticResource DarkCheck}"
                                              Content="点击关闭按钮时收进托盘（可从托盘菜单真正退出）" Margin="0,14,0,0"
                                              Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,16,0,0" Text="窗口标题" />
                                    <ComboBox x:Name="WindowTitleCombo" Style="{StaticResource DarkCombo}"
                                              Width="280" HorizontalAlignment="Left" Margin="0,8,0,0"
                                              SelectionChanged="OnSettingChanged">
                                        <ComboBoxItem Content="显示标签页标题" Tag="tabs" />
                                        <ComboBoxItem Content="固定标题（AntiCaptureBrowser）" Tag="generic" />
                                        <ComboBoxItem Content="随机标题（10 位小写字母与数字）" Tag="random" />
                                    </ComboBox>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                                               Text="随机标题每次启动重新生成，适用于不希望暴露浏览器身份的场景。" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                                               Text="隐藏窗口（快捷键）时托盘图标始终可用，双击或右键菜单可恢复窗口。" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ============ 关于 ============ -->
                    <Grid x:Name="PageAbout">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource PageIcon}">
                                    <TextBlock Style="{StaticResource PageGlyph}" Text="&#xE946;" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,2,0,0">
                                    <TextBlock Style="{StaticResource PageTitle}" Text="关于" />
                                    <TextBlock Style="{StaticResource PageDesc}" Text="版本、构建信息与开源组件" />
                                </StackPanel>
                            </Grid>

                            <!-- 版本与构建信息 -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Border Width="40" Height="40" CornerRadius="10"
                                                Background="{DynamicResource AccentBrush}">
                                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                                       Foreground="{DynamicResource BadgeFgBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="AntiCaptureBrowser" FontSize="20" FontWeight="Bold"
                                                   VerticalAlignment="Center" Margin="12,0,0,0"
                                                   Foreground="{DynamicResource ForegroundBrush}" />
                                    </StackPanel>
                                    <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,12" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                   Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                                        <StackPanel Margin="10,0,0,0">
                                            <TextBlock Text="构建信息" FontSize="13"
                                                       Foreground="{DynamicResource ForegroundBrush}" />
                                            <TextBlock x:Name="AboutVersionText" FontSize="12" Margin="0,3,0,0"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                            <TextBlock x:Name="AboutChromiumText" FontSize="11.5" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource ForegroundDimBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Grid Margin="12,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="运行时" />
                                        <TextBlock Grid.Column="1" x:Name="AboutRuntimeText" FontSize="12"
                                                   Foreground="{DynamicResource ForegroundBrush}" />
                                        <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Margin="0,6,0,0" Text="WebView2 运行时" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="AboutWebView2RuntimeText" Margin="0,6,0,0" FontSize="12"
                                                   Foreground="{DynamicResource ForegroundBrush}" />
                                        <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Margin="0,6,0,0" Text="WebView2 SDK" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="AboutWebView2SdkText" Margin="0,6,0,0" FontSize="12"
                                                   Foreground="{DynamicResource ForegroundBrush}" />
                                        <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Margin="0,6,0,0" Text="构建时间 (UTC)" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="AboutBuildTimeText" Margin="0,6,0,0" FontSize="12"
                                                   Foreground="{DynamicResource ForegroundBrush}" />
                                        <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Margin="0,6,0,0" Text="提交 ID" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="AboutCommitText" Margin="0,6,0,0" FontSize="12"
                                                   Foreground="{DynamicResource ForegroundBrush}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 开源组件 -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="使用的包与库" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,10" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text=".NET 10 / WPF" />
                                    <TextBlock Style="{StaticResource Hint}" Text="应用运行时与 UI 框架" />
                                    <TextBlock x:Name="CompRuntimeText" Style="{StaticResource Hint}" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0" />
                                    <Separator Background="{DynamicResource BorderBrush}" Margin="0,12" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Microsoft.Web.WebView2" />
                                    <TextBlock Style="{StaticResource Hint}" Text="WebView2 浏览器内核宿主（组合模式渲染）" />
                                    <TextBlock x:Name="CompWebView2Text" Style="{StaticResource Hint}" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0" />
                                    <Separator Background="{DynamicResource BorderBrush}" Margin="0,12" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Microsoft.Windows.SDK.NET" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Windows API 投影（WebView2 组合渲染依赖）" />
                                    <TextBlock x:Name="CompSdkNetText" Style="{StaticResource Hint}" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- 版权与许可 -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="AntiCaptureBrowser" />
                                    <TextBlock x:Name="AboutCopyrightText" Style="{StaticResource Hint}" Margin="0,4,0,10" />
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="基于 .NET 10 与 WebView2 构建。配置、缓存与浏览数据保存在本程序目录下的 Data 文件夹中，可直接整个目录拷贝或删除。" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="NoResultsText" Text="没有找到匹配的设置" FontSize="14"
                               Foreground="{DynamicResource ForegroundDimBrush}" Visibility="Hidden"
                               HorizontalAlignment="Center" Margin="0,30,0,0" />
                    <TextBlock x:Name="SavedText" Text="✓ 设置已自动保存" FontSize="12"
                               Foreground="{DynamicResource SuccessBrush}" Visibility="Hidden"
                               HorizontalAlignment="Center" Margin="0,8,0,0" />

                </StackPanel>
            </controls:SmoothScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
