<UserControl x:Class="AntiCaptureBrowser.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AntiCaptureBrowser.Controls"
             Background="{StaticResource ToolbarBgBrush}">
    <UserControl.Resources>
        <!-- ===== 侧边栏导航项 ===== -->
        <Style x:Key="NavRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="12,9">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="glyph" Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets"
                                           FontSize="14" VerticalAlignment="Center" Width="20"
                                           Foreground="{StaticResource ForegroundDimBrush}" />
                                <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"
                                                  RecognizesAccessKey="False" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2B2C2F" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E2B3D" />
                                <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 页面标题 ===== -->
        <Style x:Key="PageIcon" TargetType="Border">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="#33415580" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="PageGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
        </Style>
        <Style x:Key="PageDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource ForegroundDimBrush}" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>

        <!-- ===== 卡片与控件 ===== -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="BorderBrush" Value="#323336" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,0,26" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource ForegroundDimBrush}" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource ForegroundDimBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource FieldBgBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource ForegroundBrush}" />
            <Setter Property="BorderBrush" Value="#3C4043" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ComboItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}"
                                CornerRadius="6" Margin="4,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3C5A99" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="{StaticResource FieldBgBrush}"
                                                BorderBrush="#3C4043" BorderThickness="1" CornerRadius="8">
                                            <Path Data="M 0 0 L 4.5 5 L 9 0" Stroke="{StaticResource ForegroundDimBrush}"
                                                  StrokeThickness="1.6" HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" Margin="0,0,12,0" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#5F6368" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="12,7,34,7" IsHitTestVisible="False"
                                              VerticalAlignment="Center" RecognizesAccessKey="False" />
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" StaysOpen="False" Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="#2B2C2F" BorderBrush="#3C4043" BorderThickness="1"
                                        CornerRadius="8" Margin="0,6,0,0" MaxHeight="280" MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ComboItemStyle}" />
        </Style>

        <Style x:Key="DarkCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="box" Width="19" Height="19" CornerRadius="5"
                                    Background="{StaticResource FieldBgBrush}"
                                    BorderBrush="#5F6368" BorderThickness="1" VerticalAlignment="Center">
                                <Path x:Name="check" Data="M 3.5 9 L 7.5 13 L 14.5 4.5" Stroke="#202124"
                                      StrokeThickness="2" Visibility="Collapsed"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"
                                              RecognizesAccessKey="False" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModeRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{StaticResource FieldBgBrush}"
                                BorderBrush="#3C4043" BorderThickness="1.5" CornerRadius="10"
                                Padding="14,12">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#5F6368" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="bd" Property="Background" Value="#1E2B3D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== 左侧分类导航 ==================== -->
        <Border Grid.Column="0" Background="{StaticResource ChromeBgBrush}">
            <DockPanel Margin="14,20,14,14">
                <!-- 底部：关于 -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Separator Background="#3C4043" Margin="0,0,0,10" />
                    <RadioButton x:Name="NavAbout" Style="{StaticResource NavRadio}" GroupName="SettingsNav"
                                 Tag="&#xE946;" Content="关于" Checked="Nav_Checked" />
                    <TextBlock Text="AntiCaptureBrowser v1.0" FontSize="11" Margin="12,6,0,0"
                               Foreground="{StaticResource ForegroundDimBrush}" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="设置" FontSize="24" FontWeight="Bold" Margin="10,0,0,22"
                               Foreground="{StaticResource ForegroundBrush}" />
                    <RadioButton x:Name="NavGeneral" Style="{StaticResource NavRadio}" GroupName="SettingsNav"
                                 Tag="&#xE80F;" Content="常规" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavSearch" Style="{StaticResource NavRadio}" GroupName="SettingsNav"
                                 Tag="&#xE721;" Content="搜索引擎" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavPrivacy" Style="{StaticResource NavRadio}" GroupName="SettingsNav"
                                 Tag="&#xE72E;" Content="隐私与捕获保护" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavHotkey" Style="{StaticResource NavRadio}" GroupName="SettingsNav"
                                 Tag="&#xE765;" Content="快捷键" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavMedia" Style="{StaticResource NavRadio}" GroupName="SettingsNav"
                                 Tag="&#xE769;" Content="隐藏与最小化" Checked="Nav_Checked" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ==================== 右侧内容区 ==================== -->
        <DockPanel Grid.Column="1">
            <!-- 搜索设置 -->
            <Border DockPanel.Dock="Top" Background="{StaticResource FieldBgBrush}"
                    BorderBrush="#3C4043" BorderThickness="1" CornerRadius="10"
                    Margin="28,20,32,4" Padding="14,9">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                               FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0"
                               Foreground="{StaticResource ForegroundDimBrush}" />
                    <TextBlock x:Name="SearchPlaceholder" Text="搜索设置" FontSize="13" VerticalAlignment="Center"
                               Foreground="{StaticResource ForegroundDimBrush}" IsHitTestVisible="False" />
                    <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource ForegroundBrush}" CaretBrush="{StaticResource ForegroundBrush}"
                             FontSize="13" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" />
                </DockPanel>
            </Border>

            <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="800" Margin="34,22,34,36" HorizontalAlignment="Center">

                    <!-- ============ 常规 ============ -->
                    <Grid x:Name="PageGeneral">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource PageIcon}">
                                    <TextBlock Style="{StaticResource PageGlyph}" Text="&#xE80F;" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,2,0,0">
                                    <TextBlock Style="{StaticResource PageTitle}" Text="常规" />
                                    <TextBlock Style="{StaticResource PageDesc}" Text="主页与新标签页" />
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="新标签页打开" />
                                    <ComboBox x:Name="HomePageModeCombo" Style="{StaticResource DarkCombo}"
                                              Width="240" HorizontalAlignment="Left" Margin="0,8,0,10"
                                              SelectionChanged="OnSettingChanged">
                                        <ComboBoxItem Content="自定义网址" Tag="CustomUrl" />
                                        <ComboBoxItem Content="空白页" Tag="Blank" />
                                    </ComboBox>
                                    <TextBox x:Name="HomePageUrlBox" Style="{StaticResource FieldBox}"
                                             TextChanged="OnSettingChanged" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                               Text="提示：地址栏输入网址回车即导航；输入普通文字则用「搜索引擎」分类中选择的引擎搜索。" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ============ 搜索引擎 ============ -->
                    <Grid x:Name="PageSearch">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource PageIcon}">
                                    <TextBlock Style="{StaticResource PageGlyph}" Text="&#xE721;" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,2,0,0">
                                    <TextBlock Style="{StaticResource PageTitle}" Text="搜索引擎" />
                                    <TextBlock Style="{StaticResource PageDesc}" Text="地址栏输入文字时使用的搜索服务" />
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="搜索引擎" />
                                    <ComboBox x:Name="SearchEngineCombo" Style="{StaticResource DarkCombo}"
                                              Width="240" HorizontalAlignment="Left" Margin="0,8,0,10"
                                              SelectionChanged="OnSettingChanged">
                                        <ComboBoxItem Content="Google" Tag="google" />
                                        <ComboBoxItem Content="Bing" Tag="bing" />
                                        <ComboBoxItem Content="DuckDuckGo" Tag="duckduckgo" />
                                        <ComboBoxItem Content="百度" Tag="baidu" />
                                        <ComboBoxItem Content="自定义…" Tag="custom" />
                                    </ComboBox>
                                    <TextBox x:Name="CustomSearchUrlBox" Style="{StaticResource FieldBox}"
                                             TextChanged="OnSettingChanged" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                               Text="自定义 URL 模板需包含 {query} 或 %s 占位符，例如：https://example.com/search?q=%s" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ============ 隐私与捕获保护 ============ -->
                    <Grid x:Name="PagePrivacy">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource PageIcon}">
                                    <TextBlock Style="{StaticResource PageGlyph}" Text="&#xE72E;" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,2,0,0">
                                    <TextBlock Style="{StaticResource PageTitle}" Text="隐私与捕获保护" />
                                    <TextBlock Style="{StaticResource PageDesc}"
                                               Text="窗口在截图、录屏、屏幕共享中的显示方式（SetWindowDisplayAffinity）" />
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="捕获保护模式" />
                                    <UniformGrid Columns="3" Margin="0,10,0,0">
                                        <RadioButton x:Name="CaptureCapturable" Style="{StaticResource ModeRadio}"
                                                     GroupName="CaptureMode" Margin="0,0,8,0" Checked="OnSettingChanged">
                                            <StackPanel>
                                                <TextBlock Text="可捕获" FontSize="13.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource ForegroundBrush}" />
                                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                                           Text="正常显示，截图与共享中可见" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="CaptureBlack" Style="{StaticResource ModeRadio}"
                                                     GroupName="CaptureMode" Margin="0,0,8,0" Checked="OnSettingChanged">
                                            <StackPanel>
                                                <TextBlock Text="黑色" FontSize="13.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource ForegroundBrush}" />
                                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                                           Text="截图中窗口显示为黑色" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="CaptureTransparent" Style="{StaticResource ModeRadio}"
                                                     GroupName="CaptureMode" Checked="OnSettingChanged">
                                            <StackPanel>
                                                <TextBlock Text="透明（推荐）" FontSize="13.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource AccentBrush}" />
                                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                                           Text="防捕获：截图中窗口完全不可见" />
                                            </StackPanel>
                                        </RadioButton>
                                    </UniformGrid>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                                               Text="修改后立即生效。「透明」通过 WDA_EXCLUDEFROMCAPTURE 实现：窗口本体在屏幕上仍正常显示，但任何截图、录屏、屏幕共享、远程软件都看不到它。" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ============ 快捷键 ============ -->
                    <Grid x:Name="PageHotkey">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource PageIcon}">
                                    <TextBlock Style="{StaticResource PageGlyph}" Text="&#xE765;" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,2,0,0">
                                    <TextBlock Style="{StaticResource PageTitle}" Text="快捷键" />
                                    <TextBlock Style="{StaticResource PageDesc}" Text="全局热键在任意程序中都可用" />
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="隐藏 / 恢复窗口（全局热键）" />
                                    <controls:HotkeyBox x:Name="HideHotkeyBox" Width="220" HorizontalAlignment="Left"
                                                        Margin="0,8,0,0" Style="{StaticResource FieldBox}"
                                                        HotkeyChanged="OnSettingChanged" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                               Text="点击输入框后按下组合键即可录入（如 Ctrl+Alt+B）。在任意程序中按此热键可瞬间隐藏/恢复本浏览器。" />
                                    <TextBlock x:Name="HotkeyStatusText" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ============ 隐藏与最小化 ============ -->
                    <Grid x:Name="PageMedia">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource PageIcon}">
                                    <TextBlock Style="{StaticResource PageGlyph}" Text="&#xE769;" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,2,0,0">
                                    <TextBlock Style="{StaticResource PageTitle}" Text="隐藏与最小化" />
                                    <TextBlock Style="{StaticResource PageDesc}" Text="窗口隐藏或最小化时的媒体行为" />
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <CheckBox x:Name="MuteOnHideCheck" Style="{StaticResource DarkCheck}"
                                              Content="静音所有标签页"
                                              Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                                    <CheckBox x:Name="PauseOnHideCheck" Style="{StaticResource DarkCheck}"
                                              Content="暂停页面中的音视频播放" Margin="0,14,0,0"
                                              Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                                               Text="恢复窗口时自动取消静音。" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ============ 关于 ============ -->
                    <Grid x:Name="PageAbout">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource PageIcon}">
                                    <TextBlock Style="{StaticResource PageGlyph}" Text="&#xE946;" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,2,0,0">
                                    <TextBlock Style="{StaticResource PageTitle}" Text="关于" />
                                    <TextBlock Style="{StaticResource PageDesc}" Text="版本信息与数据存储位置" />
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}"
                                               Text="AntiCaptureBrowser 1.0 — 基于 .NET 10 与 WebView2 的防捕获浏览器" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                               Text="所有配置、缓存与浏览数据均保存在本程序目录下的 Data 文件夹中，可直接整个目录拷贝或删除。" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="NoResultsText" Text="没有找到匹配的设置" FontSize="14"
                               Foreground="{StaticResource ForegroundDimBrush}" Visibility="Hidden"
                               HorizontalAlignment="Center" Margin="0,30,0,0" />
                    <TextBlock x:Name="SavedText" Text="✓ 设置已自动保存" FontSize="12"
                               Foreground="{StaticResource SuccessBrush}" Visibility="Hidden"
                               HorizontalAlignment="Center" Margin="0,8,0,0" />

                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
